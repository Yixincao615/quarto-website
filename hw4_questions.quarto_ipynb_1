    "J_total = 10\n",
    "\n",
    "def make_beta_full(beta_free):\n",
    "    return np.concatenate([[0], beta_free])\n",
    "\n",
    "def log_likelihood(beta_free, task_data):\n",
    "\n",
    "    beta = make_beta_full(beta_free)\n",
    "\n",
    "    total_ll = 0.0\n",
    "\n",
    "    for _, row in task_data.iterrows():\n",
    "\n",
    "        shown = np.array(row[\"shown\"], dtype=int) - 1\n",
    "\n",
    "        best = int(row[\"best\"]) - 1\n",
    "        worst = int(row[\"worst\"]) - 1\n",
    "\n",
    "        beta_shown = beta[shown]\n",
    "\n",
    "        # Best choice probability\n",
    "        ll_best = beta[best] - logsumexp(beta_shown)\n",
    "\n",
    "        # Worst choice probability\n",
    "        remaining = shown[shown != best]\n",
    "\n",
    "        ll_worst = (\n",
    "            -beta[worst]\n",
    "            - logsumexp(-beta[remaining])\n",
    "        )\n",
    "\n",
    "        total_ll += ll_best + ll_worst\n",
    "\n",
    "    return total_ll\n",
    "\n",
    "\n",
    "def neg_log_likelihood(beta_free, task_data):\n",
    "    return -log_likelihood(beta_free, task_data)"
