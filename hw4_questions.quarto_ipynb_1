    "def bootstrap_counts(data, labels, B=1000):\n",
    "    respondents = data[\"record_id\"].unique()\n",
    "    boot_rows = []\n",
    "\n",
    "    for b in range(B):\n",
    "        sampled_ids = np.random.choice(respondents, size=len(respondents), replace=True)\n",
    "        boot_parts = []\n",
    "\n",
    "        for new_id, sampled_id in enumerate(sampled_ids):\n",
    "            temp = data[data[\"record_id\"] == sampled_id].copy()\n",
    "            temp[\"boot_id\"] = new_id\n",
    "            boot_parts.append(temp)\n",
    "\n",
    "        boot_data = pd.concat(boot_parts, ignore_index=True)\n",
    "\n",
    "        boot_score = (\n",
    "            boot_data.groupby(\"item_id\")\n",
    "            .agg(\n",
    "                times_shown=(\"response\", \"size\"),\n",
    "                times_best=(\"response\", lambda x: (x == 1).sum()),\n",
    "                times_worst=(\"response\", lambda x: (x == -1).sum())\n",
    "            )\n",
    "            .reset_index()\n",
    "        )\n",
    "\n",
    "        boot_score[\"score\"] = (\n",
    "            boot_score[\"times_best\"] / boot_score[\"times_shown\"]\n",
    "            - boot_score[\"times_worst\"] / boot_score[\"times_shown\"]\n",
    "        )\n",
    "\n",
    "        boot_score[\"iteration\"] = b\n",
    "        boot_rows.append(boot_score[[\"item_id\", \"score\", \"iteration\"]])\n",
    "\n",
    "    boot_df = pd.concat(boot_rows, ignore_index=True)\n",
    "\n",
    "    ci = (\n",
    "        boot_df.groupby(\"item_id\")[\"score\"]\n",
    "        .quantile([0.025, 0.975])\n",
    "        .unstack()\n",
    "        .reset_index()\n",
    "        .rename(columns={0.025: \"ci_low\", 0.975: \"ci_high\"})\n",
    "    )\n",
    "\n",
    "    return ci.merge(labels, on=\"item_id\", how=\"left\")\n",
    "\n",
    "boot_ci = bootstrap_counts(data, labels, B=1000)\n",
    "\n",
    "counts_table_ci = counts_table.merge(\n",
    "    boot_ci[[\"item_id\", \"ci_low\", \"ci_high\"]],\n",
    "    on=\"item_id\",\n",
    "    how=\"left\"\n",
    ")\n",
    "\n",
    "display(counts_table_ci)"
